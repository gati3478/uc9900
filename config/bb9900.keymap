#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/ext_power.h>

#define SYM 1
#define UPPER 2
#define TABS 3

 


/ {
    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mkp LCLK>, <&bt BT_CLR>;
        };
    };
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <500>;
            bindings = <&out &kp>;
        };
    };

    behaviors {
        // hold-preferred: B rolled straight into a D-pad key is the tab layer, never Ctrl+Space.
        lt_hp: layer_tap_hold_preferred {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
            // Only a D-pad key (positions 0 5 6 7) makes B the layer; any other key keeps
            // it the prefix, so a fast "B, c" still reaches tmux.
            hold-trigger-key-positions = <0 5 6 7>;
        };
        shot: screenshot_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <300>;
            bindings = <&kp>, <&kp>;
        };
        // A tap is a one-shot Shift; a hold is a plain Shift. A bare &sk stays down for
        // release-after-ms after a Shift+click, since mouse buttons don't release it.
        sks: sticky_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            retro-tap;
            bindings = <&kp>, <&sk>;
        };
        ZMK_MACRO(tmux_prev, wait-ms = <0>; tap-ms = <10>; bindings = <&macro_tap &kp LC(SPACE) &kp P>;)
        ZMK_MACRO(tmux_next, wait-ms = <0>; tap-ms = <10>; bindings = <&macro_tap &kp LC(SPACE) &kp N>;)
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {

            bindings = <
//---------------------------------------------------------------------------------------------------------
// |  ←  | ↑   | ↓   | →   |  Mleft  |  Mright |  Trackpad    |  Y  |  B  |  X  |  A  |                                       
// |  ESC   |  SELECT  | Start |                 voive  |   [  |  ]  |   /  |  -  |  =  |  \  |
// |   ~   |  1  |  2  |  3  |  4  |  5  |  6  |  7  |  8  |  9  |  0  |  Backspace  |
// |   TAB   |  Q  |  W  |  E  |  R  |  T  |  Y  |  U  |  I  |  O  |  P  | 
// |    '      |  A  |  S  |  D  |  F  |  G  |  H  |  J  |  K  |  L  |  ;  |     ENTER   |  
// |  LShift  |  Z  |  X  |  C  |  V  |  B  |  N  |  M  |  <  |  >  |  ;  |  RShift  |  
//        |  Fn  |  LCtrl  |  Alt   |      SPACE      |   Alt   |  RCtrl   |  Fn   |  
//        -----------------------------------------------------------------------------------------------------------------
// The front plate holds this unit's left mouse button (Mleft) closed, and the trackpad press
// stays closed once pressed (22-11-2026), so both send nothing; Y clicks left, X right. A and R send F14-F16: xkb turns those
// into XF86Launch5-7, which nothing binds (F21-F23 become touchpad toggles).
            &kp LEFT                      &none             &none          &mkp LCLK &mkp RCLK
&kp UP   &kp DOWN &kp RIGHT               &shot F16 F15                   &lt_hp TABS LC(SPACE)      &kp F14
&kp ESC    &kp CAPS  &kp LGUI &kp K_MUTE    &kp LBKT   &kp RBKT   &kp FSLH   &kp MINUS  &kp  EQUAL &kp BACKSLASH                                                                                  
&kp GRAVE  &kp N1        &kp N2     &kp N3   &kp N4     &kp N5     &kp N6     &kp N7     &kp N8    &kp N9  &kp N0 &kp BSPC
&kp TAB     &kp Q         &kp W      &kp E    &kp R      &kp T      &kp Y      &kp U      &kp I     &kp O   &kp P
&kp SQT     &kp A         &kp S      &kp D    &kp F      &kp G      &kp H      &kp J      &kp K     &kp L   &kp SEMICOLON &kp ENTER        
&sks LSHFT LSHFT   &kp Z         &kp X      &kp C    &kp V      &kp B      &kp N      &kp M      &kp COMMA &kp DOT &sks RSHFT RSHFT
  &mo SYM   &kp LCTRL               &kp LALT              &kp SPACE           &kp RALT         &kp RCTRL     &mo UPPER        
            >;
        };


        sym_layer {

            bindings = <
        &kp LEFT                      &none             &none          &kp Y   &kp X
&kp K_VOL_UP   &kp K_VOL_DN &kp RIGHT               &mkp RCLK                       &kp  B      &kp A
&kp C_AL_SCREENSAVER  &kp C_AC_PRINT &kp C_PLAY_PAUSE  &kp K_VOL_UP &none   &none   &none   &kp F11    &kp F12   &bootloader                                                                                   
&none    &kp F1         &kp F2        &kp F3     &kp F4     &kp F5     &kp F6     &kp F7     &kp F8    &kp F9  &kp F10 &kp DEL
&kp CAPSLOCK    &kp Q          &kp W         &kp E      &kp R      &kp T      &kp Y      &kp PAGE_UP      &kp INSERT     &kp O   &kp P
&none    &kp A          &kp S         &kp D      &kp F      &kp G      &kp HOME      &kp END      &kp PAGE_DOWN     &kp L   &none &none         
&none    &kp Z          &kp X         &kp C      &kp V      &kp B      &kp N      &kp M      &kp C_BRI_DN &kp C_BRI_UP &kp RSHFT
  &none  &kp LCTRL               &kp LGUI             &bl BL_TOG           &mo SYM         &mo SYM     &mo UPPER           

            >;
        };


        upper_layer {

            bindings = <
        &kp LEFT                      &none             &none          &kp Y   &kp X
&kp UP   &kp DOWN &kp RIGHT               &mkp RCLK                       &kp  B      &kp A
&bt BT_CLR  &kp C_AC_PRINT &mkp C_PAUSE  &kp K_VOL_DN &none   &none   &none   &kp F11    &kp F12   &bootloader                                                                                   
&none     &bt BT_SEL 0          &bt BT_SEL 1         &bt BT_SEL 2      &bt BT_SEL 3     &kp F5     &kp F6     &kp F7     &kp F8    &kp F9  &kp F10 &kp DEL
&kp CAPSLOCK    &kp Q          &kp W         &kp E      &kp R      &kp T      &kp Y      &kp PAGE_UP      &kp INSERT     &kp O   &kp P
&none    &kp A          &kp S         &kp D      &kp F      &kp G      &kp HOME      &kp END      &kp PAGE_DOWN     &kp L   &none &none         
&none    &kp Z          &kp X         &kp C      &kp V      &kp B      &kp N      &kp M      &kp C_BRI_DN &kp C_BRI_UP &kp RSHFT
  &sys_reset  &kp LCTRL               &kp LALT             &bl BL_CYCLE           &mo SYM         &none     &none           

            >;
        };


        tabs_layer {

            bindings = <
        &tmux_prev                    &trans            &trans         &trans  &trans
&kp LC(LS(LEFT))   &kp LC(LS(RIGHT)) &tmux_next       &trans                       &trans      &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans  &trans  &trans

            >;
        };

    };
};
&sk { release-after-ms = <3000>; };
